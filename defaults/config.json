{
  "version": 1,
  "project_kind": "other",
  "git": {
    "protected_branches": ["main", "master", "release/*"],
    "integration_branch_pattern": "lanekeeper/*/int",
    "lane_branch_pattern": "lanekeeper/*/l*",
    "worktree_root": "{repo}/../wt-{task}",
    "main_checkout": "auto",
    "feature_push": "ask",
    "gate_stamp": "lanekeeper-gate-pass",
    "owner_grant_ttl_min": 15
  },
  "paths": {
    "briefs": ".lanekeeper/briefs/{lane}.md",
    "lane_reports": "{scratch_root}/reports/{lane}.md",
    "reports_final": "docs/reports/{date}/{slug}.md",
    "artifacts_temp": "{scratch_root}/art/{slug}/",
    "artifacts_keep": "docs/reports/artifacts/{slug}/",
    "artifacts_keep_webp": { "over_kb": 300, "quality": 80 },
    "decisions": "docs/decisions/{date}-{slug}.md",
    "test_results": "docs/test-results/{date}/{name}-{HHMM}.xlsx",
    "test_runs_raw": "test-results/runs/{name}-{stamp}/",
    "metrics": ".lanekeeper/metrics/",
    "e2e_ledger": "docs/e2e/"
  },
  "gate": { "command": "", "verify_all": "", "append_checks": [] },
  "glossary": { "terms_dict": "docs/glossary/terms.yaml", "terms_scan": "docs/glossary/config.json", "copy_globs": [] },
  "style": { "map": [
    { "glob": "docs/**/*.md", "style": "report" }
  ] },
  "mockup": { "ui_globs": [], "tokens_css": "", "decision_required": true },
  "codegraph": { "nudge": "warn", "auto_index": true },
  "ui_stability": { "enabled": false, "adapter": "uistab.adapter.ts" },
  "slots": { "heavy": [], "browser": [] },
  "worktree": { "setup": "", "hook": false },
  "protected_paths": [],
  "protected_data": { "paths": [], "ports": [], "containers": [] },
  "lanes": { "commit": "allowed" },
  "dispatch": { "brief": "deny", "exempt_agents": ["fork", "claude-code-guide", "statusline-setup"] },
  "waves": { "stale_min": 20 },
  "numbers": {},
  "review": { "guards": [], "report_fields": ["head", "tests", "remaining"] },
  "integrate": {
    "rules": [
      { "glob": "**/*.cases.json", "kind": "ledger" },
      { "glob": "**/defect-register.json", "kind": "ledger" },
      { "glob": "**/hooks/hooks.json", "kind": "union" },
      { "glob": "**/*.xlsx", "kind": "generated" },
      { "glob": "**/package-lock.json", "kind": "generated" },
      { "glob": "**/pnpm-lock.yaml", "kind": "generated" },
      { "glob": "**/yarn.lock", "kind": "generated" }
    ],
    "regenerate": [],
    "guards": []
  },
  "explain": { "links": [] },
  "quality": {
    "results_root": "docs/test-results",
    "raw_root": "test-results/runs",
    "version_file": "VERSION",
    "suites": {},
    "ship": {
      "requires": [],
      "advisory": ["ux-adversarial"],
      "enforce": "deny",
      "agents": ["readiness-auditor"],
      "skills": ["verifying-production-readiness"]
    }
  },
  "release": {
    "gates": [],
    "security_check": "",
    "security_required": false,
    "security_stamp": "lanekeeper-security-pass",
    "tag_patterns": ["v*"]
  },
  "docs_sync": {
    "base": "main",
    "release_tag": "v*",
    "quality_base": "release",
    "screen_sources": [],
    "screen_exclude": [],
    "ignore": ["**/*.test.*", "**/*.spec.*"],
    "text_pattern": "",
    "min_phrase_length": 4,
    "max_files_per_phrase": 12,
    "targets": [],
    "rules": [],
    "mirrors": [],
    "groups": [],
    "reverse_index": { "targets": [], "exclude": [] },
    "shots": { "scripts": [], "command": "" },
    "screen_registry": {},
    "autofix": [],
    "checks": [],
    "manual_items": [],
    "ack_file": ".lanekeeper/docs-sync-acks.json",
    "style": "",
    "fail_on": "required"
  }
}
