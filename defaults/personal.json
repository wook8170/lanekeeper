{
  "version": 1,
  "language": "auto",
  "report": {
    "chat_detail": "summary",
    "viewer": "local",
    "artifact_fallback": "html-file",
    "artifact_check": true
  },
  "auto_retry": {
    "enabled": false,
    "permission_mode": "default",
    "bypass_ack": false
  },
  "paths": {
    "scratch_root": "~/.lanekeeper-scratch/{project}"
  },
  "token_guard": {
    "enabled": true,
    "stages": [
      90,
      95,
      99
    ],
    "budget": 0,
    "window_hours": 5,
    "fresh_min": 10,
    "source": "auto"
  },
  "terse": false,
  "search": {
    "rg_hint": true
  },
  "global_hooks": "defer",
  "session_rules": {
    "language": true,
    "remote": true,
    "conduct": true
  },
  "handoff": {
    "enabled": true,
    "inject": "summary",
    "file": "progress.md",
    "throttle_min": 20,
    "max_lines": 300,
    "archive_dir": "docs/progress-archive"
  },
  "checkpoint": {
    "enabled": true
  },
  "design_plugin": ""
}
