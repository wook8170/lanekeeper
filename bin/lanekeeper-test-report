#!/usr/bin/env node
// lanekeeper-test-report — test result workbook (xlsx) from vitest · jest · Playwright · pytest results.
//
//   lanekeeper-test-report env                         Python 3.8+ and openpyxl available? (exit 3 when not)
//   lanekeeper-test-report init                        write .lanekeeper/verify.config.json from the template (stage list to edit)
//   lanekeeper-test-report run [--name N] [--skip a,b] [--only a,b] [--ledger-priority P0] [--no-slot]
//                                              gate -> every stage -> workbook, no bail
//   lanekeeper-test-report gate [--no-bail] [--skip a]  gate steps one by one into gate.json
//   lanekeeper-test-report gate-pass                   run project.gate.command; on a pass write the gate pass stamp
//   lanekeeper-test-report security-pass [--force]     run project.release.security_check; on a pass write the release
//                                              security stamp (skipped when this commit already passed)
//   lanekeeper-test-report build [core options]        workbook from results (default: newest folder under test_runs_raw)
//   lanekeeper-test-report latest                      path of the newest workbook
//   lanekeeper-test-report summary [--json]            counts of the newest workbook (for /lanekeeper:report)
//
// A full pass of `run` (no --skip/--only) or of `gate-pass` on a clean HEAD writes the gate pass stamp
// <git common dir>/lanekeeper/<project.git.gate_stamp>.json { head, at, command }; the safety hook needs it for a
// protected merge or push when project.gate.command is set.
// Without Python or openpyxl, run and build print how to install them and skip the workbook (exit 0;
// --require makes it exit 3). Core and runners: templates/test-results/{core,project}.
import fs from 'node:fs'
import path from 'node:path'
import { spawnSync } from 'node:child_process'
import { pathToFileURL } from 'node:url'
import { projectRel } from '../lib/naming.mjs'

const libDir = path.join(path.dirname(fs.realpathSync(process.argv[1])), '..', 'lib')
const imp = (f) => import(pathToFileURL(path.join(libDir, f)).href)
const { load, parseOptions } = await imp('cli.mjs')
const { stateDir } = await imp('config.mjs')
const { translator } = await imp('i18n.mjs')
const R = await imp('testresults.mjs')
const REL = await imp('release.mjs')

const BOOLEANS = ['json', 'require', 'no-slot', 'no-bail', 'force']
const argv = process.argv.slice(2)
const args = parseOptions(argv, BOOLEANS)
const { root, resolved } = load(args)
const t = translator(resolved.effective.language)
const print = (s = '') => process.stdout.write(`${s}\n`)
const warn = (s) => process.stderr.write(`${s}\n`)
const [cmd] = args._
const paths = R.resultPaths(root, resolved.config)

function envGuide(py) {
  warn(t(py.python === 'missing' ? 'tr.env.no_python' : py.python === 'old' ? 'tr.env.old_python' : 'tr.env.no_openpyxl', { version: py.version }))
  warn(t('tr.env.install'))
}

// Returns true when the workbook can be built; otherwise prints the guide and the skip notice.
function ready() {
  const py = R.pythonStatus()
  if (py.ok) return true
  envGuide(py)
  warn(t('tr.skipped'))
  return false
}

const finish = (code, needed) => process.exit(needed && args.require ? 3 : code)

// Hold <git common dir>/lanekeeper/gate.lock while the gate or verify run is in progress, so
// merges wait for it. A second run while one is alive stops with exit 3.
function withGateLock(command, fn) {
  const lock = R.acquireGateLock(stateDir(root), { command })
  if (!lock.ok) {
    warn(t('tr.gate_locked', { pid: lock.pid }))
    process.exit(3)
  }
  const stop = (sig) => {
    lock.release()
    process.exit(sig === 'SIGINT' ? 130 : 143)
  }
  process.on('SIGINT', stop)
  process.on('SIGTERM', stop)
  try {
    return fn()
  } finally {
    lock.release()
  }
}

// Before a run: the commit and whether tracked files are unchanged. After a pass: the stamp, when
// the same commit is still checked out and nothing tracked changed.
function stampAfter(before, command, code) {
  if (code !== 0) return
  const after = R.headState(root)
  if (!before.head || !before.clean || !after.clean || after.head !== before.head) {
    warn(t('tr.stamp.not_clean'))
    return
  }
  const file = R.stampFile(stateDir(root), resolved.config)
  R.writeGateStamp(file, { head: before.head, command })
  print(t('tr.stamp.written', { head: before.head.slice(0, 9), file }))
}

const COMMANDS = {
  env() {
    const py = R.pythonStatus()
    if (py.ok) return print(t('tr.env.ok', { version: py.version }))
    envGuide(py)
    process.exit(3)
  },
  init() {
    const dest = path.join(root, projectRel(root, R.VERIFY_CONFIG))
    if (fs.existsSync(dest)) return print(t('tr.init.exists', { file: R.VERIFY_CONFIG }))
    fs.mkdirSync(path.dirname(dest), { recursive: true })
    fs.copyFileSync(path.join(R.PROJECT_DIR, 'verify.config.json'), dest)
    print(t('tr.init.created', { file: R.VERIFY_CONFIG }))
  },
  run() {
    const config = path.join(root, projectRel(root, R.VERIFY_CONFIG))
    if (!fs.existsSync(config)) {
      warn(t('tr.no_config', { file: R.VERIFY_CONFIG }))
      process.exit(2)
    }
    const a = [path.join(R.PROJECT_DIR, 'verify-all.mjs'), `--root=${root}`, `--config=${config}`, `--runs-dir=${paths.runsDir}`,
      `--cases-dir=${paths.ledgerDir}`, `--out-template=${paths.resultsTemplate}`, `--lang=${resolved.effective.language === 'ko' ? 'ko' : 'en'}`]
    for (const k of ['name', 'skip', 'only', 'ledger-priority']) if (typeof args[k] === 'string') a.push(`--${k}=${args[k]}`)
    if (args['no-slot']) a.push('--no-slot')
    const before = R.headState(root)
    const r = withGateLock('lanekeeper-test-report run', () => spawnSync(process.execPath, a, { stdio: 'inherit', env: { ...process.env, LANEKEEPER_SLOT_BIN: path.join(libDir, '..', 'bin', 'lanekeeper-slot') } }))
    const partial = ['skip', 'only'].some((k) => typeof args[k] === 'string' && args[k])
    if (partial && r.status === 0) warn(t('tr.stamp.partial'))
    else stampAfter(before, 'lanekeeper-test-report run', r.status ?? 1)
    finish(r.status ?? 1, false)
  },
  gate() {
    const config = path.join(root, projectRel(root, R.VERIFY_CONFIG))
    if (!fs.existsSync(config)) {
      warn(t('tr.no_config', { file: R.VERIFY_CONFIG }))
      process.exit(2)
    }
    const a = [path.join(R.PROJECT_DIR, 'run-gate.mjs'), `--root=${root}`, `--config=${config}`]
    if (args['no-bail']) a.push('--no-bail')
    if (typeof args.skip === 'string') a.push(`--skip=${args.skip}`)
    if (typeof args['results-dir'] === 'string') a.push(`--results-dir=${args['results-dir']}`)
    process.exit(withGateLock('lanekeeper-test-report gate', () => spawnSync(process.execPath, a, { stdio: 'inherit' })).status ?? 1)
  },
  'gate-pass'() {
    const command = resolved.config.project?.gate?.command
    if (!command) {
      warn(t('tr.stamp.no_gate'))
      process.exit(2)
    }
    const before = R.headState(root)
    print(t('tr.stamp.running', { command }))
    // project.gate.command is written by the project owner, the same trust as running it by hand
    const r = withGateLock('lanekeeper-test-report gate-pass', () => spawnSync('sh', ['-c', command], { cwd: root, stdio: 'inherit' }))
    const code = r.status ?? 1
    if (code !== 0) warn(t('tr.stamp.failed', { code }))
    stampAfter(before, command, code)
    process.exit(code)
  },
  // Release security gate. Same trust as gate-pass: the command comes from the project config.
  'security-pass'() {
    const st = REL.securityState(root, resolved.config)
    if (st.state === 'unconfigured' || st.state === 'unset') {
      warn(t('tr.security.unset'))
      process.exit(2)
    }
    if (st.state === 'ok' && !args.force) {
      print(t('tr.security.already', { head: st.head.slice(0, 9), file: st.file }))
      process.exit(0)
    }
    const before = R.headState(root)
    print(t('tr.security.running', { command: st.command }))
    const r = spawnSync('sh', ['-c', st.command], { cwd: root, stdio: 'inherit' })
    const code = r.status ?? 1
    if (code !== 0) {
      warn(t('tr.security.failed', { code }))
      process.exit(code)
    }
    const after = R.headState(root)
    if (!before.head || !before.clean || !after.clean || after.head !== before.head) {
      warn(t('tr.security.not_clean'))
      process.exit(1)
    }
    const file = R.securityStampFile(stateDir(root), resolved.config)
    R.writeGateStamp(file, { head: before.head, command: st.command })
    print(t('tr.security.written', { head: before.head.slice(0, 9), file }))
    process.exit(0)
  },
  build() {
    if (!ready()) return finish(0, true)
    const rawArgs = argv.slice(argv.indexOf('build') + 1).filter((x) => x !== '--require')
    const base = ['--repo', root, '--cases-dir', paths.ledgerDir, '--runs-dir', paths.runsDir, '--lang', resolved.effective.language === 'ko' ? 'ko' : 'en']
    if (!rawArgs.some((x) => x === '--out' || x.startsWith('--out='))) base.push('--out-template', paths.resultsTemplate)
    const r = spawnSync(R.pythonStatus().cmd, [path.join(R.CORE_DIR, 'build_xlsx.py'), ...base, ...rawArgs], { stdio: 'inherit', env: { ...process.env, PYTHONDONTWRITEBYTECODE: '1' } })
    process.exit(r.status ?? 1)
  },
  latest() {
    const f = R.findLatest(paths.resultsBase)
    if (!f) {
      warn(t('tr.none', { dir: path.relative(root, paths.resultsBase) }))
      process.exit(1)
    }
    print(path.relative(root, f))
  },
  summary() {
    const f = R.findLatest(paths.resultsBase)
    const s = f && R.summarize(R.readSummary(f))
    if (!s) {
      warn(t('tr.none', { dir: path.relative(root, paths.resultsBase) }))
      process.exit(1)
    }
    if (args.json) return print(JSON.stringify({ file: path.relative(root, f), ...s }, null, 2))
    print(t('tr.summary.head', { file: path.relative(root, f), verdict: t(`tr.verdict.${s.verdict}`), commit: s.commit || '-' }))
    for (const [kind, c] of Object.entries(s.kinds)) {
      print(`  ${kind}: ${t('tr.summary.line', { total: c.total, passed: c.passed, failed: c.failed, skipped: c.skipped, flaky: c.flaky })}`)
    }
    if (s.gate.steps) print(`  gate: ${t('tr.summary.gate', { steps: s.gate.steps, failed: s.gate.failed, notRun: s.gate.notRun })}`)
    if (s.ledger) print(`  ${t('tr.summary.ledger', { cases: s.ledger.cases, n: s.ledger.mismatches })}`)
  },
}

if (!COMMANDS[cmd]) {
  print(`usage: lanekeeper-test-report <${Object.keys(COMMANDS).join('|')}> …`)
  process.exit(2)
}
COMMANDS[cmd]()
