#!/usr/bin/env node
// lanekeeper-defects — defect register (defect-register.json in paths.e2e_ledger).
//
//   lanekeeper-defects add --title T [--severity critical|high|medium|low] [--case ID]... [--lane L] [--note N]
//   lanekeeper-defects resolve <D-id> [--status fixed|wontfix] [--note N]
//   lanekeeper-defects list [--status open|fixed|wontfix] [--json]
//   lanekeeper-defects check                               same checks as `lanekeeper-cases check`
//   lanekeeper-defects summary [--json]                    counts by status, open defects by severity
//   lanekeeper-defects export [--out DIR] [--format md,xlsx]
//                                                  defect-register.md and .xlsx next to the register
//                                                  (xlsx needs Python 3 + openpyxl; missing = exit 3)
// Defects are never deleted; a fixed one stays in the register.
import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { pathToFileURL } from 'node:url'
import { spawnSync } from 'node:child_process'

const libDir = path.join(path.dirname(fs.realpathSync(process.argv[1])), '..', 'lib')
const imp = (f) => import(pathToFileURL(path.join(libDir, f)).href)
const { context, guarded } = await imp('ledger-cli.mjs')
const C = await imp('cases.mjs')

const argv = process.argv.slice(2)
const cases = []
for (let i = 0; i < argv.length; i++) if (argv[i] === '--case' && argv[i + 1]) cases.push(argv[i + 1])
const ctx = context(argv)
const { args, t, print } = ctx
const [cmd, id] = args._
const dir = ctx.path('e2e_ledger', 'docs/e2e')

const COMMANDS = {
  add() {
    const d = C.addDefect(dir, { title: args.title, severity: args.severity, cases, lane: args.lane, note: args.note })
    print(t('defects.added', { id: d.id }))
  },
  resolve() {
    if (!id) ctx.fail('usage', { usage: 'lanekeeper-defects resolve <D-id>' }, 2)
    const d = C.resolveDefect(dir, id, { status: args.status, note: args.note })
    print(t('defects.resolved', { id: d.id, status: d.status }))
  },
  list() {
    const all = C.readDefects(dir).defects.filter((d) => !args.status || d.status === args.status)
    if (args.json) return ctx.json(all)
    if (!all.length) return print(t('defects.none'))
    for (const d of all) print(`${d.id}  ${d.severity}  ${d.status}  ${(d.case_ids || []).join(',') || '-'}  ${d.title}`)
  },
  summary() {
    const s = C.defectSummary(dir)
    if (args.json) return ctx.json(s)
    print(t('defects.md.summary', { total: s.total, open: s.status.open, fixed: s.status.fixed, wontfix: s.status.wontfix }))
    if (s.open_ids.length) print(`  ${s.open_ids.join(', ')}`)
  },
  export() {
    const out = args.out ? path.resolve(String(args.out)) : dir
    const formats = String(args.format || 'md,xlsx').split(',')
    fs.mkdirSync(out, { recursive: true })
    const written = []
    if (formats.includes('md')) {
      const f = path.join(out, 'defect-register.md')
      fs.writeFileSync(f, C.defectsMarkdown(dir, t))
      written.push(f)
    }
    if (formats.includes('xlsx')) {
      const cols = ['id', 'severity', 'status', 'cases', 'found', 'fixed', 'lane', 'title', 'note']
      const labels = {
        sheet: t('defects.md.title'),
        columns: cols.map((c) => t(`defects.col.${c}`)),
        severity: Object.fromEntries(C.SEVERITIES.map((s) => [s, t(`defects.sev.${s}`)])),
        status: Object.fromEntries(C.DEFECT_STATUSES.map((s) => [s, t(`defects.st.${s}`)])),
      }
      const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'lanekeeper-defects-'))
      const lf = path.join(tmp, 'labels.json')
      const src = path.join(tmp, 'register.json')
      fs.writeFileSync(lf, JSON.stringify(labels))
      fs.writeFileSync(src, JSON.stringify(C.readDefects(dir)))
      const xf = path.join(out, 'defect-register.xlsx')
      const py = process.env.LANEKEEPER_PYTHON || 'python3'
      const r = spawnSync(py, [path.join(libDir, '..', 'templates', 'defects', 'build-defects-xlsx.py'), src, xf, lf], { encoding: 'utf8' })
      fs.rmSync(tmp, { recursive: true, force: true })
      if (r.status !== 0) {
        for (const f of written) print(f)
        process.stderr.write(`[lanekeeper] ${t('defects.xlsx_missing')}\n`)
        process.exit(3)
      }
      written.push(xf)
    }
    for (const f of written) print(f)
  },
  check() {
    const problems = C.checkLedger(dir)
    if (args.json) ctx.json(problems)
    else if (!problems.length) print(t('cases.ok'))
    else for (const p of problems) print(`✗ ${t(`cases.problem.${p.code}`, p.vars)}`)
    process.exit(problems.length ? 1 : 0)
  },
}
if (!COMMANDS[cmd]) {
  print(`usage: lanekeeper-defects <${Object.keys(COMMANDS).join('|')}> …`)
  process.exit(2)
}
await guarded(ctx, () => COMMANDS[cmd]())
