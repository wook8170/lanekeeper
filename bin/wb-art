#!/usr/bin/env node
// wb-art — artifacts to keep or to throw away, and a one-file HTML report.
//
//   wb-art keep <file>... --slug S [--json]     into paths.artifacts_keep (committed);
//                                               a PNG over artifacts_keep_webp.over_kb becomes WebP
//   wb-art temp <file>... --slug S [--json]     into paths.artifacts_temp (scratch, not committed)
//   wb-art report --title T --md FILE [--image LABEL=FILE]... [--slug S] [--keep] [--out FILE]
//                                               one HTML file; images embedded as data: URIs
//                                               (big PNG converted to WebP first)
//   wb-art env                                  which PNG → WebP converter is available
// Converter: cwebp, else Python Pillow. Without one a big PNG is copied as is with a warning.
import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { pathToFileURL } from 'node:url'

const libDir = path.join(path.dirname(fs.realpathSync(process.argv[1])), '..', 'lib')
const imp = (f) => import(pathToFileURL(path.join(libDir, f)).href)
const { parseOptions, load } = await imp('cli.mjs')
const { translator } = await imp('i18n.mjs')
const A = await imp('art.mjs')

const argv = process.argv.slice(2)
const args = parseOptions(argv, ['json', 'keep'])
const { root, resolved } = load(args)
const lang = resolved.effective.language
const t = translator(lang)
const print = (s = '') => process.stdout.write(`${s}\n`)
const [cmd, ...files] = args._
const slug = String(args.slug || new Date().toISOString().slice(0, 10))
const webp = A.webpSettings(resolved.config)

function show(rows) {
  if (args.json) return print(JSON.stringify(rows, null, 2))
  for (const r of rows) {
    const kb = (n) => `${Math.round(n / 1024)}KB`
    print(r.converted ? t('art.converted', { src: r.src, dest: r.dest, a: kb(r.bytesIn), b: kb(r.bytesOut) }) : t('art.copied', { src: r.src, dest: r.dest }))
    if (r.warn) process.stderr.write(`[wb] ${t(`art.${r.warn}`, { over: webp.over_kb })}\n`)
  }
}

function needFiles() {
  const missing = files.filter((f) => !fs.existsSync(f))
  if (!files.length || missing.length) {
    process.stderr.write(`[wb] ${t('art.no_files', { files: missing.join(', ') || '-' })}\n`)
    process.exit(2)
  }
}

const COMMANDS = {
  keep() {
    needFiles()
    show(A.placeFiles(files, A.artPath(root, resolved.config, 'artifacts_keep', slug), { webp }))
  },
  temp() {
    needFiles()
    show(A.placeFiles(files, A.artPath(root, resolved.config, 'artifacts_temp', slug), { webp, convert: false }))
  },
  report() {
    if (!args.title || !args.md || !fs.existsSync(String(args.md))) {
      print('usage: wb-art report --title T --md FILE [--image LABEL=FILE]... [--keep] [--out FILE]')
      process.exit(2)
    }
    const pairs = []
    for (let i = 0; i < argv.length; i++) if (argv[i] === '--image' && argv[i + 1]) pairs.push(argv[++i])
    const images = pairs.map((p) => {
      const at = p.indexOf('=')
      return at > 0 ? { label: p.slice(0, at), file: p.slice(at + 1) } : { label: path.basename(p), file: p }
    })
    const missing = images.filter((im) => !fs.existsSync(im.file)).map((im) => im.file)
    if (missing.length) {
      process.stderr.write(`[wb] ${t('art.no_files', { files: missing.join(', ') })}\n`)
      process.exit(2)
    }
    const dir = A.artPath(root, resolved.config, args.keep ? 'artifacts_keep' : 'artifacts_temp', slug)
    const work = fs.mkdtempSync(path.join(os.tmpdir(), 'wb-art-'))
    const placed = A.placeFiles(images.map((im) => im.file), work, { webp })
    const html = A.buildReportHtml({
      title: String(args.title),
      markdown: fs.readFileSync(String(args.md), 'utf8'),
      images: images.map((im, i) => ({ label: im.label, file: placed[i].dest })),
      lang,
    })
    fs.rmSync(work, { recursive: true, force: true })
    const out = args.out ? path.resolve(String(args.out)) : path.join(dir, 'index.html')
    fs.mkdirSync(path.dirname(out), { recursive: true })
    fs.writeFileSync(out, html)
    for (const r of placed) if (r.warn) process.stderr.write(`[wb] ${t(`art.${r.warn}`, { over: webp.over_kb })}\n`)
    const size = fs.statSync(out).size
    if (args.json) print(JSON.stringify({ file: out, bytes: size, images: placed.length }, null, 2))
    else print(t('art.report', { file: out, kb: Math.round(size / 1024), n: placed.length }))
    if (size > 16 * 1024 * 1024) {
      process.stderr.write(`[wb] ${t('art.too_big')}\n`)
      process.exit(1)
    }
  },
  env() {
    const c = A.findConverter(process.env)
    print(c ? t('art.env_ok', { name: c.name, over: webp.over_kb, q: webp.quality }) : t('art.env_none'))
    process.exit(c ? 0 : 3)
  },
}
if (!COMMANDS[cmd]) {
  print(`usage: wb-art <${Object.keys(COMMANDS).join('|')}> …`)
  process.exit(2)
}
COMMANDS[cmd]()
