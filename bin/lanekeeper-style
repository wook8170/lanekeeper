#!/usr/bin/env node
// lanekeeper-style — writing style per file (project.style.map).
//
//   lanekeeper-style of <path...> [--json]          style of each path (first matching glob wins)
//   lanekeeper-style rules [haeyo|report|plain]     full rule text for a style (all three when omitted)
//   lanekeeper-style text <path...>                 the one-line text that fills {{style}} in a brief
//   lanekeeper-style brief <type|file> [--owned a,b] [--var k=v]...
//                                           brief template with {{style}} (and any --var) filled in;
//                                           {{code_standards}} gets the line for project.code_standards.doc,
//                                           or its line is dropped when no document is set;
//                                           {{readability}} gets the readable code rules unless
//                                           project.code_standards.readability.enabled is false;
//                                           {{docs_search}} gets the docs search line when
//                                           project.docs_search.search is set, or its line is dropped;
//                                           {{code_search}} gets "codegraph first for code, the index
//                                           first for documents" unless project.codegraph.nudge is off
//
// Common options: --project <dir>, --lang ko|en
import fs from 'node:fs'
import path from 'node:path'
import { pathToFileURL } from 'node:url'

const libDir = path.join(path.dirname(fs.realpathSync(process.argv[1])), '..', 'lib')
const imp = (f) => import(pathToFileURL(path.join(libDir, f)).href)
const { load, parseOptions } = await imp('cli.mjs')
const { translator } = await imp('i18n.mjs')
const { PLUGIN_ROOT, getPath } = await imp('config.mjs')
const S = await imp('style.mjs')
const CS = await imp('code-standards.mjs')
const RD = await imp('readability.mjs')
const DS = await imp('docs-search.mjs')

const argv = process.argv.slice(2)
const vars = {}
for (let i = 0; i < argv.length; i++) {
  if (argv[i] === '--var' && argv[i + 1]) {
    const [k, ...v] = argv[i + 1].split('=')
    vars[k] = v.join('=')
  }
}
const args = parseOptions(argv, ['json'])
const { resolved } = load(args)
const lang = args.lang === 'ko' || args.lang === 'en' ? args.lang : resolved.effective.language
const t = translator(lang)
const map = getPath(resolved.config, 'project.style.map') || []
const print = (s = '') => process.stdout.write(`${s}\n`)
const [cmd, ...rest] = args._

if (cmd === 'of') {
  if (!rest.length) (print('usage: lanekeeper-style of <path...>'), process.exit(2))
  const rows = rest.map((p) => ({ path: p, ...(S.styleFor(map, p) || { style: null, glob: null }) }))
  if (args.json) print(JSON.stringify(rows, null, 2))
  else for (const r of rows) print(`${r.path}\t${r.style ? `${t(`style.${r.style}.name`)} (${r.style}, ${r.glob})` : t('style.none')}`)
} else if (cmd === 'rules') {
  const which = rest[0] ? [rest[0]] : S.STYLES
  for (const s of which) {
    const body = S.styleRules(s, lang)
    if (!body) (process.stderr.write(`[lanekeeper] ${t('style.unknown', { style: s })}\n`), process.exit(2))
    print(`## ${t(`style.${s}.name`)} (${s})\n${body}\n`)
  }
} else if (cmd === 'text') {
  print(S.renderStyle(map, rest, t))
} else if (cmd === 'brief') {
  if (!rest[0]) (print('usage: lanekeeper-style brief <type|file> [--owned a,b]'), process.exit(2))
  const named = path.join(PLUGIN_ROOT, 'templates', 'briefs', lang, `${rest[0]}.md`)
  const file = fs.existsSync(rest[0]) ? rest[0] : named
  if (!fs.existsSync(file)) (process.stderr.write(`[lanekeeper] ${t('style.no_template', { name: rest[0] })}\n`), process.exit(2))
  const owned = args.owned ? String(args.owned).split(',').map((s) => s.trim()).filter(Boolean) : []
  const all = { style: S.renderStyle(map, owned, t), ...vars }
  if (owned.length && !('owned_files' in all)) all.owned_files = owned.join(', ')
  let text = fs.readFileSync(file, 'utf8')
  if (!('code_standards' in vars)) text = CS.applyToBrief(text, CS.briefLine(resolved.config, t))
  if (!('readability' in vars)) text = CS.applyToBrief(text, RD.briefText(resolved.config, t), 'readability')
  if (!('code_search' in vars)) text = CS.applyToBrief(text, DS.codeSearchLine(resolved.config, t), 'code_search')
  if (!('docs_search' in vars)) text = CS.applyToBrief(text, DS.briefLine(resolved.config, t), 'docs_search')
  process.stdout.write(S.fillTemplate(text, all))
} else {
  print('usage: lanekeeper-style of|rules|text|brief …')
  process.exit(2)
}
