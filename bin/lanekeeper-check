#!/usr/bin/env node
// lanekeeper-check — project checks. Each subcommand lives in its own lib module.
//
//   lanekeeper-check brief <file|-> [--json]   brief marker, required sections and statements
//                                     (exit 1 = incomplete). Brief files it names
//                                     (common briefs) are read as well.
//   lanekeeper-check test-results [--json] [--require-pass]
//                                     newest test result workbook exists and is committed;
//                                     the ledger matches the run when a ledger exists (exit 1 = no)
//   lanekeeper-check lane <lane> [--head SHA] [--base REF] [--report FILE] [--return FILE] [--brief FILE]
//                 [--lane-dir DIR] [--capture FILE]... [--captures-seen] [--serve-url URL --marker TEXT]
//                 [--stage lane|integration|final] [--scope GLOB,...] [--wave W --record] [--json]
//                                     the nine review items of /lanekeeper:review-lane (exit 1 = a fail;
//                                     a return brief is written for the lane)
import fs from 'node:fs'
import path from 'node:path'
import { pathToFileURL } from 'node:url'

const libDir = path.join(path.dirname(fs.realpathSync(process.argv[1])), '..', 'lib')
const imp = (f) => import(pathToFileURL(path.join(libDir, f)).href)
const argv = process.argv.slice(2)
const flags = new Set(argv.filter((a) => a.startsWith('--')))
const [cmd, target] = argv.filter((a) => !a.startsWith('--'))
const print = (s) => process.stdout.write(`${s}\n`)

async function brief() {
  if (!target) {
    print('usage: lanekeeper-check brief <file|->')
    process.exit(2)
  }
  const { resolveConfig, projectRoot } = await imp('config.mjs')
  const { translator } = await imp('i18n.mjs')
  const { checkBrief, collectBrief } = await imp('brief.mjs')
  const root = projectRoot(process.cwd(), process.env)
  const t = translator(resolveConfig({ projectDir: root, env: process.env }).effective.language)
  let raw
  try {
    raw = target === '-' ? fs.readFileSync(0, 'utf8') : fs.readFileSync(target, 'utf8')
  } catch (e) {
    process.stderr.write(`[lanekeeper] ${t(e.code === 'ENOENT' ? 'brief.not_found' : 'brief.unreadable', { file: target, error: e.code || e.message })}\n`)
    process.exit(2)
  }
  const base = target === '-' ? process.cwd() : path.dirname(path.resolve(target))
  const b = collectBrief(raw, { cwd: base, projectRoot: root })
  const r = checkBrief(b.text)
  if (flags.has('--json')) print(JSON.stringify({ ...r, files: b.files }, null, 2))
  else {
    print(t(r.ok ? 'brief.ok' : 'brief.fail', { file: target }))
    for (const m of r.missing) print(`  ✗ ${t(`brief.item.${m}`)}`)
    if (r.placeholder) print(`  ✗ {{${r.placeholder}}}`)
    if (r.marker) print(`  type=${r.marker.attrs.type || '-'} lane=${r.marker.attrs.lane || '-'} template=${r.marker.attrs.template || '-'}`)
  }
  process.exit(r.ok ? 0 : 1)
}

async function testResults() {
  const { resolveConfig, projectRoot } = await imp('config.mjs')
  const { translator } = await imp('i18n.mjs')
  const { checkTestResults } = await imp('testresults.mjs')
  const root = projectRoot(process.cwd(), process.env)
  const resolved = resolveConfig({ projectDir: root, env: process.env })
  const t = translator(resolved.effective.language)
  const r = checkTestResults(root, resolved.config, { requirePass: flags.has('--require-pass') })
  if (flags.has('--json')) print(JSON.stringify({ ok: r.ok, file: r.file, json: r.json, items: r.items }, null, 2))
  else {
    print(t(r.ok ? 'tr.check.ok' : 'tr.check.fail'))
    const mark = { ok: '✓', warn: '⚠', fail: '✗' }
    for (const i of r.items) print(`  ${mark[i.level]} ${t(`tr.check.${i.id}`, i.vars)}`)
    if (!r.ok) print(t('tr.check.how'))
  }
  process.exit(r.ok ? 0 : 1)
}

function many(name) {
  const out = []
  for (let i = 0; i < argv.length; i++) if (argv[i] === `--${name}` && argv[i + 1]) out.push(argv[i + 1])
  return out
}

async function lane() {
  const { parseOptions } = await imp('cli.mjs')
  const a = parseOptions(argv.slice(1), ['json', 'captures-seen', 'record'])
  const laneId = a._[0]
  if (!laneId) {
    print('usage: lanekeeper-check lane <lane> [--head SHA] [--report FILE] …')
    process.exit(2)
  }
  const { resolveConfig, projectRoot, getPath } = await imp('config.mjs')
  const { translator } = await imp('i18n.mjs')
  const R = await imp('review.mjs')
  const W = await imp('waves.mjs')
  const root = projectRoot(process.cwd(), process.env)
  if (!W.ID_RE.test(String(laneId))) {
    process.stderr.write(`[lanekeeper] ${translator(resolveConfig({ projectDir: root, env: process.env }).effective.language)('ledger.err.waves.bad_id', { kind: 'lane', id: laneId })}\n`)
    process.exit(2)
  }
  const resolved = resolveConfig({ projectDir: root, env: process.env })
  const lang = resolved.effective.language
  const t = translator(lang)
  const rel = (p) => (p ? path.resolve(String(p)) : undefined)
  const reportPath = rel(a.report)
  const result = await R.reviewLane({
    root,
    laneDir: rel(a['lane-dir']),
    head: a.head ? String(a.head) : undefined,
    base: a.base ? String(a.base) : undefined,
    report: reportPath,
    returnText: a.return ? fs.readFileSync(String(a.return), 'utf8') : undefined,
    brief: rel(a.brief),
    scope: a.scope ? String(a.scope).split(',') : [],
    captures: many('capture'),
    capturesSeen: !!a['captures-seen'],
    serveUrl: a['serve-url'] ? String(a['serve-url']) : undefined,
    marker: a.marker ? String(a.marker) : undefined,
    stage: a.stage ? String(a.stage) : 'lane',
    config: resolved.config,
    env: process.env,
  })
  const fails = result.items.filter((i) => i.status === 'fail')
  let brief = null
  if (fails.length) {
    // the lane's real branch and worktree: the --lane-dir checkout, else the lanes.json record
    const { stateDir } = await imp('config.mjs')
    const { readLanes } = await imp('ledger.mjs')
    const sd = stateDir(root)
    const rec = sd ? readLanes(sd).lanes.find((l) => l.id === laneId) : null
    const laneDir = a['lane-dir'] ? String(a['lane-dir']) : rec?.worktree
    const head = laneDir && fs.existsSync(laneDir) ? R.gitx(laneDir, ['symbolic-ref', '-q', '--short', 'HEAD']) : null
    const branch = (head?.status === 0 && head.out) || rec?.branch
    brief = R.writeReturnBrief({
      root,
      config: resolved.config,
      lang,
      lane: laneId,
      title: t('review.return_title', { n: fails.length }),
      findings: fails.map((i) => `${i.n}. ${t(`review.item.${i.id}`)}: ${t(`review.${i.code}`, i.vars)} — ${t(`review.fix.${i.id}`)}`),
      base: result.base || '-',
      worktree: laneDir,
      branch,
      report: reportPath,
      style: (getPath(resolved.config, 'project.style.map') || []).find((m) => m.glob.endsWith('.md'))?.style,
    })
  }
  if (a.record && a.wave) {
    try {
      R.recordReview(root, String(a.wave), laneId, result, fails.map((i) => `${i.n}:${i.code}`).join(', ') || 'pass')
    } catch (e) {
      process.stderr.write(`[lanekeeper] ${e.message}\n`)
    }
  }
  if (a.json) print(JSON.stringify({ ...result, brief }, null, 2))
  else {
    const mark = { pass: '✓', fail: '✗', skip: '–' }
    print(t(result.verdict === 'pass' ? 'review.pass' : 'review.fail', { lane: laneId, n: fails.length }))
    for (const i of result.items) print(`  ${mark[i.status]} ${i.n}. ${t(`review.item.${i.id}`)} — ${t(`review.${i.code}`, i.vars)}`)
    if (brief) print(t('review.brief_written', { file: path.relative(process.cwd(), brief) }))
  }
  process.exit(result.verdict === 'pass' ? 0 : 1)
}

const COMMANDS = { brief, 'test-results': testResults, lane }
if (!COMMANDS[cmd]) {
  print(`usage: lanekeeper-check <${Object.keys(COMMANDS).join('|')}> …`)
  process.exit(2)
}
await COMMANDS[cmd]()
