#!/usr/bin/env node
// lanekeeper-waves — wave and lane ledger, progress board, resume report.
//
//   lanekeeper-waves init-wave <wave> [--title T] [--base-ref REF]
//   lanekeeper-waves lane <wave> <lane> [--task T] [--model M] [--brief FILE] [--todo TEXT]...
//   lanekeeper-waves status <wave> <lane> pending|running|review|blocked|failed|done [--note N]
//   lanekeeper-waves todo <wave> <lane> add TEXT | done ID | reopen ID
//   lanekeeper-waves verify <wave> <lane> NAME pass|fail|skip [--detail D]
//   lanekeeper-waves note <wave> <lane> TEXT
//   lanekeeper-waves return <wave> <lane> [--reason R]      a reviewer sent the lane back
//   lanekeeper-waves board [--json]                         wave / lane table
//   lanekeeper-waves statusline                             one line for subagentStatusLine
//   lanekeeper-waves metrics [--lane L] [--json]            runs, tokens and models per lane
//   lanekeeper-waves resume [--json] [--stale-min N] [--prompt WAVE/LANE]
//   lanekeeper-waves handoff check [--json]                   progress.md lines against the target, archive files
//   lanekeeper-waves handoff archive "<summary>" [--from FILE] append FILE (default: the whole progress.md) to the monthly archive
//   lanekeeper-waves handoff migrate [--force]                move an oversized progress.md to the archive, write a fresh one
import fs from 'node:fs'
import path from 'node:path'
import { pathToFileURL } from 'node:url'

const libDir = path.join(path.dirname(fs.realpathSync(process.argv[1])), '..', 'lib')
const imp = (f) => import(pathToFileURL(path.join(libDir, f)).href)
const { context, guarded } = await imp('ledger-cli.mjs')
const W = await imp('waves.mjs')
const B = await imp('board.mjs')
const { getPath } = await imp('config.mjs')

const argv = process.argv.slice(2)
// "--todo" may repeat on `lane`; collect before the generic parser keeps only the last.
const todos = []
for (let i = 0; i < argv.length; i++) if (argv[i] === '--todo' && argv[i + 1]) todos.push(argv[i + 1])
const ctx = context(argv, ['force'])
const { args, t, print } = ctx
const [cmd, a, b, c, d] = args._

const need = (n) => {
  if (args._.length < n + 1) ctx.fail('usage', { usage: `lanekeeper-waves ${cmd || '<command>'} …` }, 2)
}

const COMMANDS = {
  'init-wave'() {
    need(1)
    const w = W.initWave(ctx.needState(), { id: a, title: args.title, base_ref: args['base-ref'] })
    print(t('waves.created_wave', { wave: w.id }))
  },
  lane() {
    need(2)
    const l = W.addLane(ctx.needState(), a, { lane: b, task: args.task, model: args.model, brief: args.brief, todos })
    print(t('waves.created_lane', { wave: a, lane: l.lane }))
  },
  status() {
    need(3)
    const l = W.setStatus(ctx.needState(), a, b, c, args.note)
    print(t('waves.status_set', { lane: l.lane, status: t(`board.status.${l.status}`) }))
  },
  todo() {
    need(3)
    const sd = ctx.needState()
    if (c === 'add') print(t('waves.todo_added', { id: W.addTodo(sd, a, b, d).id }))
    else if (c === 'done' || c === 'reopen') print(t('waves.todo_set', { id: W.setTodo(sd, a, b, d, c === 'done').id, state: c }))
    else ctx.fail('usage', { usage: 'lanekeeper-waves todo <wave> <lane> add TEXT | done ID | reopen ID' }, 2)
  },
  verify() {
    need(4)
    W.addVerification(ctx.needState(), a, b, c, d, args.detail)
    print(t('waves.verified', { name: c, result: d }))
  },
  note() {
    need(3)
    W.addNote(ctx.needState(), a, b, c)
    print(t('waves.noted'))
  },
  return() {
    need(2)
    const l = W.addReturn(ctx.needState(), a, b, args.reason)
    print(t('waves.returned', { lane: l.lane, count: l.returns }))
  },
  board() {
    const rows = B.boardRows(ctx.needState())
    if (args.json) ctx.json(rows)
    else print(B.renderBoard(rows, t))
  },
  statusline() {
    const sd = ctx.state()
    const max = getPath(ctx.resolved.config, 'machine.lanes.max') || 3
    print(sd ? B.statusLine(B.boardRows(sd), t, max) : t('board.statusline.none'))
  },
  metrics() {
    const sd = ctx.needState()
    const per = {}
    for (const m of W.readMetrics(sd)) {
      if (m.event !== 'stop' || (args.lane && m.lane !== args.lane)) continue
      const k = m.lane || '-'
      const r = (per[k] = per[k] || { lane: k, runs: 0, models: {}, tokens: { input: 0, output: 0, cache_read: 0, cache_creation: 0 } })
      r.runs++
      const model = m.actual_model || m.model || '-'
      r.models[model] = (r.models[model] || 0) + 1
      for (const key of Object.keys(r.tokens)) r.tokens[key] += m.tokens?.[key] || 0
    }
    const rows = Object.values(per)
    if (args.json) return ctx.json(rows)
    if (!rows.length) return print(t('metrics.none'))
    for (const r of rows) print(`${r.lane}  ${t('metrics.runs', { n: r.runs })}  ${t('metrics.tokens', { n: B.tokenTotal(r.tokens) })}  ${Object.entries(r.models).map(([m, n]) => `${m}×${n}`).join(' ')}`)
  },
  async resume() {
    const { buildResume, resumePrompt } = await imp('resume.mjs')
    const staleMin = Number(args['stale-min'] || getPath(ctx.resolved.config, 'project.waves.stale_min') || 20)
    const { handoffSettings } = await imp('handoff.mjs')
    const hs = handoffSettings(getPath(ctx.resolved.config, 'personal.handoff') || {})
    const rep = buildResume({ cwd: ctx.root, state: ctx.state(), progressFile: hs.file, maxLines: hs.maxLines, archiveDir: hs.archiveDir, staleMin })
    if (args.prompt) {
      const [wave, lane] = String(args.prompt).split('/')
      const rec = rep.lanes.find((x) => x.wave === wave && x.lane === lane)
      if (!rec) ctx.fail('no_lane', { wave, lane })
      return print(resumePrompt(rec, t))
    }
    if (args.json) return ctx.json(rep)
    print(`# ${t('resume.h.progress')}`)
    print(rep.progress ? rep.progress.excerpt : t('resume.no_progress'))
    if (rep.progress) print(`\n${t('resume.archive', { archive: hs.archiveDir, lines: rep.progress.lines, max: hs.maxLines })}`)
    print(`\n# ${t('resume.h.git')}`)
    print(`${t('resume.branch')}: ${rep.git.branch || '-'}`)
    print(rep.git.status.length ? rep.git.status.slice(0, 30).join('\n') : t('resume.clean'))
    print(`${t('resume.worktrees')}:`)
    for (const w of rep.git.worktrees) print(`  ${w.path}  ${w.branch || '-'}`)
    print(`${t('resume.log')}:`)
    for (const l of rep.git.log) print(`  ${l.hash} ${l.subject}`)
    print(`\n# ${t('resume.h.lanes')}`)
    if (!rep.lanes.length) print(t('board.empty'))
    for (const l of rep.lanes) print(`  ${l.wave}/${l.lane}  ${t(`resume.verdict.${l.verdict}`)}  ${l.model || '-'}  ${t('resume.remaining', { n: l.remaining.length })}${l.last_commit ? `  ${l.last_commit}` : ''}`)
    print(`\n# ${t('resume.h.stale')}`)
    if (!rep.stale.length) print(t('resume.stale_none'))
    for (const s of rep.stale) print(`  - ${t(`resume.stale.${s.code}`, s.vars)}`)
    if (rep.next.length) {
      print(`\n# ${t('resume.h.next')}`)
      for (const n of rep.next) print(`  - ${t(`resume.next.${n.action}`, { wave: n.wave, lane: n.lane })}`)
    }
  },
  async handoff() {
    const H = await imp('handoff.mjs')
    const hs = H.handoffSettings(getPath(ctx.resolved.config, 'personal.handoff') || {})
    const cwd = ctx.root
    const vars = { file: hs.file, max: hs.maxLines, archive: hs.archiveDir }
    if (a === 'check' || a === undefined) {
      const size = H.sizeCheck(cwd, hs.file, hs.maxLines)
      const dir = path.join(cwd, hs.archiveDir)
      const files = fs.existsSync(dir) ? fs.readdirSync(dir).filter((f) => f.endsWith('.md')).sort() : []
      if (size.over) process.exitCode = 1
      if (args.json) return ctx.json({ ...size, file: hs.file, archive: hs.archiveDir, archive_files: files })
      if (!size.exists) print(t('handoff.cli.missing', vars))
      else print(t(size.over ? 'handoff.cli.over' : 'handoff.cli.ok', { ...vars, lines: size.lines }))
      print(t('handoff.cli.archive', { ...vars, count: files.length }))
      for (const f of files) print(`  ${path.join(hs.archiveDir, f)}`)
      return
    }
    if (a === 'archive') {
      need(2)
      if (args.from && args.from !== true) {
        const src = path.resolve(process.cwd(), String(args.from))
        if (!fs.existsSync(src)) ctx.fail('handoff_no_from', { path: src })
        const to = H.appendArchive({ cwd, archiveDir: hs.archiveDir, title: b, body: fs.readFileSync(src, 'utf8') })
        return print(t('handoff.cli.archived', { ...vars, to }))
      }
      const r = H.archiveCurrent({ cwd, file: hs.file, archiveDir: hs.archiveDir, title: b })
      if (!r.archived) ctx.fail('handoff_no_file', vars)
      print(t('handoff.cli.archived', { ...vars, to: r.to }))
      return print(t('handoff.cli.rewrite', vars))
    }
    if (a === 'migrate') {
      const r = H.migrateLegacy({ cwd, file: hs.file, archiveDir: hs.archiveDir, maxLines: hs.maxLines, t, force: args.force === true })
      if (r.reason === 'missing') ctx.fail('handoff_no_file', vars)
      if (!r.moved) return print(t('handoff.cli.small', { ...vars, lines: r.lines }))
      print(t('handoff.cli.migrated', { ...vars, to: r.to, lines: r.lines }))
      return print(t('handoff.cli.rewrite', vars))
    }
    ctx.fail('usage', { usage: 'lanekeeper-waves handoff check|archive "<summary>" [--from FILE]|migrate [--force]' }, 2)
  },
}

if (!COMMANDS[cmd]) {
  print(`usage: lanekeeper-waves <${Object.keys(COMMANDS).join('|')}> …`)
  process.exit(2)
}
await guarded(ctx, () => COMMANDS[cmd]())
