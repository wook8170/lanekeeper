#!/usr/bin/env node
// lanekeeper-work — turn a one-line request into a lane flow and show where the flow stands.
//
//   lanekeeper-work plan "<request>" [--json]    request kind, ordered steps and the model each agent step uses
//   lanekeeper-work progress [--json]            seven-stage progress line from the lane ledger
//
// Common options: --project <dir>, --lang ko|en
import fs from 'node:fs'
import path from 'node:path'
import { pathToFileURL } from 'node:url'

const libDir = path.join(path.dirname(fs.realpathSync(process.argv[1])), '..', 'lib')
const imp = (f) => import(pathToFileURL(path.join(libDir, f)).href)
const { load, parseOptions } = await imp('cli.mjs')
const { translator } = await imp('i18n.mjs')
const { stateDir, getPath } = await imp('config.mjs')
const { limitsFile } = await imp('runtime.mjs')
const { limitsMap, routingOf } = await imp('route.mjs')
const W = await imp('work.mjs')
const { boardRows } = await imp('board.mjs')

const args = parseOptions(process.argv.slice(2), ['json'])
const { root, resolved } = load(args)
const lang = args.lang === 'ko' || args.lang === 'en' ? args.lang : resolved.effective.language
const t = translator(lang)
const print = (s = '') => process.stdout.write(`${s}\n`)
const [cmd, ...rest] = args._

if (cmd === 'plan') {
  const request = rest.join(' ').trim()
  if (!request) (print('usage: lanekeeper-work plan "<request>"'), process.exit(2))
  const plan = W.buildPlan({ request, routing: routingOf(resolved), limits: limitsMap(limitsFile(resolved)), designPlugin: getPath(resolved.config, 'personal.design_plugin') })
  if (args.json) print(JSON.stringify(plan, null, 2))
  else {
    print(t('work.kind', { kind: t(`work.kind.${plan.kind}`) }))
    for (const s of plan.steps) {
      const who = s.model ? t('work.model', { model: s.model }) : s.wait ? t('work.wait', { until: s.wait }) : ''
      print(`  ${s.n}. ${t(`work.step.${s.id}`)}${who ? ` (${who})` : ''}`)
    }
    if (plan.harness) print(`\n${t(`work.harness.${plan.harness}`, { name: plan.design_plugin || '' })}`)
  }
} else if (cmd === 'progress') {
  const sd = stateDir(root)
  const rows = sd ? boardRows(sd) : []
  const p = W.progressFrom(rows)
  if (args.json) print(JSON.stringify(p, null, 2))
  else print(W.renderProgress(p, t))
} else {
  print('usage: lanekeeper-work plan "<request>" | progress')
  process.exit(2)
}
